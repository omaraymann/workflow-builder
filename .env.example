# Copy this file to .env.local and fill in your own values:
#   Windows:      copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# .env.local is git-ignored by Next.js and must never be committed.

# --- The model provider -----------------------------------------------------
# The openai package is the client, not necessarily the provider. Point it at
# whichever of these you are using; only one set needs real values.
#
# OpenRouter (hosted, free tier, no card):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-...
#
# Ollama (local, free, no account):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#
# OpenAI proper (paid, needs a card):
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=CHANGEME
OPENAI_API_KEY=CHANGEME

# The model each node's question is sent to.
OPENAI_MODEL=CHANGEME

# --- Inngest ----------------------------------------------------------------
# Tells the SDK to talk to the local Dev Server rather than Inngest Cloud.
INNGEST_DEV=1
